# 复制为 .env 后填写，重启服务即可生效

# Claude API Key（必填，用于 AI 笔记、翻译、会议纪要、问答）
ANTHROPIC_API_KEY=

# 可选：主模型（笔记 / 纪要 / 问答），默认 claude-opus-5-5
# AI_MODEL=claude-opus-5-5
# 可选：实时字幕翻译用的模型，默认与主模型相同；想要更低延迟和成本可设为 claude-haiku-5-5
# AI_FAST_MODEL=claude-haiku-5-5

# 可选：TURN 服务器（跨公司网络 / 4G 等复杂网络建议配置）
# TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# PORT=3000
